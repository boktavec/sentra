# Local development defaults; match infra/docker/.env.example. Not for deployed environments.
# The Postgres role is created NOLOGIN by migration 007; run `task stack:pipeline-role` once to give it this password.
PIPELINE_DATABASE_URL=postgresql://sentra_pipeline:sentra-pipeline@localhost:5440/sentra
PIPELINE_S3_ENDPOINT=http://localhost:8333
PIPELINE_S3_ACCESS_KEY=sentra-pipeline-dev
PIPELINE_S3_SECRET_KEY=sentra-pipeline-dev-secret
PIPELINE_S3_BUCKET=sentra-raw
PIPELINE_KAFKA_BOOTSTRAP=127.0.0.1:19092
# Must be at least the API's upload cap (SBOM_MAX_BYTES, default 10 MiB).
PIPELINE_MAX_SBOM_BYTES=10485760
PIPELINE_METRICS_PORT=9103
