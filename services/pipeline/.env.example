# Local development defaults; match infra/docker/.env.example. Not for deployed environments.
# The Postgres role is created NOLOGIN by migration 007; run `task stack:pipeline-role` once to give it this password.
PIPELINE_DATABASE_URL=postgresql://sentra_pipeline:sentra-pipeline@localhost:5440/sentra
PIPELINE_S3_ENDPOINT=http://localhost:8333
PIPELINE_S3_ACCESS_KEY=sentra-pipeline-dev
PIPELINE_S3_SECRET_KEY=sentra-pipeline-dev-secret
PIPELINE_S3_BUCKET=sentra-raw
PIPELINE_KAFKA_BOOTSTRAP=127.0.0.1:19092
# Must be at least the API's upload cap (SBOM_MAX_BYTES, default 10 MiB).
PIPELINE_MAX_SBOM_BYTES=10485760
# Components per SBOM before it is rejected (assumed; see the SENTRA-6 spec).
PIPELINE_MAX_COMPONENTS=50000
PIPELINE_METRICS_PORT=9103

# Vulnerability normalizer (SENTRA-11). The Postgres role is created NOLOGIN by migration 009; run
# `task stack:normalizer-role` once to give it this password. It reads raw artifacts with the pipeline's read-only storage identity.
NORMALIZER_DATABASE_URL=postgresql://sentra_normalizer:sentra-normalizer@localhost:5440/sentra
NORMALIZER_S3_ENDPOINT=http://localhost:8333
NORMALIZER_S3_ACCESS_KEY=sentra-pipeline-dev
NORMALIZER_S3_SECRET_KEY=sentra-pipeline-dev-secret
NORMALIZER_S3_BUCKET=sentra-raw
NORMALIZER_KAFKA_BOOTSTRAP=127.0.0.1:19092
NORMALIZER_METRICS_PORT=9104

# Correlator (SENTRA-13). The Postgres role is created NOLOGIN by migration 010; run
# `task stack:correlator-role` once to give it this password.
CORRELATOR_DATABASE_URL=postgresql://sentra_correlator:sentra-correlator@localhost:5440/sentra
CORRELATOR_KAFKA_BOOTSTRAP=127.0.0.1:19092
CORRELATOR_METRICS_PORT=9105
# Scheduled full re-match (assumed 24h; see the SENTRA-13 spec).
CORRELATOR_SWEEP_INTERVAL_SECONDS=86400
