# Local development defaults; match infra/docker/.env.example. Not for deployed environments.
# Postgres role is created NOLOGIN by migration 006; run `task stack:crawler-role` once to give it this password.
CRAWLER_DATABASE_URL=postgresql://sentra_crawler:sentra-crawler@localhost:5440/sentra
CRAWLER_S3_ENDPOINT=http://localhost:8333
CRAWLER_S3_ACCESS_KEY=sentra-dev
CRAWLER_S3_SECRET_KEY=sentra-dev-secret
CRAWLER_S3_BUCKET=sentra-raw
CRAWLER_CREATE_BUCKET=1
CRAWLER_KAFKA_BOOTSTRAP=127.0.0.1:19092
# k1=secret,k2=secret2: several keys let rotation overlap.
CRAWLER_SIGNING_KEYS=k1=dev-signing-secret
CRAWLER_METRICS_HOST=127.0.0.1
CRAWLER_METRICS_PORT=9102
# GitHub token for `ghsa` runs (public data: a fine-grained token with no extra permissions is enough). Never commit one.
# CRAWLER_GITHUB_TOKEN=

# Scheduler (SENTRA-10). Role created NOLOGIN by migration 017; run `task stack:scheduler-role` once.
# SCHEDULER_ENABLED=false is the kill switch: the process logs that it is disabled and exits.
SCHEDULER_ENABLED=true
SCHEDULER_DATABASE_URL=postgresql://sentra_scheduler:sentra-scheduler@localhost:5440/sentra
# Optional: SCHEDULER_CONFIG (default schedules.toml), SCHEDULER_TICK_SECONDS=30, SCHEDULER_EXPIRY_SECONDS=900,
# SCHEDULER_MAX_ACTIVE_RUNS=2, SCHEDULER_METRICS_HOST=127.0.0.1, SCHEDULER_METRICS_PORT=9103
