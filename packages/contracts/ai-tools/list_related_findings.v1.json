{
  "tool": "list_related_findings",
  "version": 1,
  "description": "Open findings in the same project that share this finding's package (same_package) or advisory group (same_advisory_group), excluding the finding under investigation. Pass nextCursor back as cursor for the next page.",
  "arguments": {
    "type": "object",
    "required": ["relation"],
    "additionalProperties": false,
    "properties": {
      "relation": { "enum": ["same_package", "same_advisory_group"] },
      "limit": { "type": "integer", "minimum": 1, "maximum": 10 },
      "cursor": { "type": "string", "maxLength": 200 }
    }
  },
  "result": {
    "type": "object",
    "required": ["items", "nextCursor"],
    "additionalProperties": false,
    "properties": {
      "items": {
        "type": "array",
        "maxItems": 10,
        "items": {
          "type": "object",
          "required": [
            "findingId", "purl", "version", "scope", "matchQuality", "advisory", "priorityTier", "kevStatus"
          ],
          "additionalProperties": false,
          "properties": {
            "findingId": { "type": "string" },
            "purl": { "type": "string" },
            "version": { "type": "string" },
            "scope": { "enum": ["required", "optional", "excluded"] },
            "matchQuality": { "enum": ["confirmed", "unverifiable"] },
            "advisory": {
              "type": "object",
              "required": ["source", "sourceId", "aliases"],
              "additionalProperties": false,
              "properties": {
                "source": { "type": "string" },
                "sourceId": { "type": "string" },
                "aliases": { "type": "array", "maxItems": 10, "items": { "type": "string" } }
              }
            },
            "priorityTier": { "enum": ["P1", "P2", "P3", "P4"] },
            "kevStatus": { "enum": ["listed", "not_listed", "unavailable"] }
          }
        }
      },
      "nextCursor": { "type": ["string", "null"] }
    }
  }
}
