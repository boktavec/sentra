{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentra.dev/contracts/events/vulnerabilities.normalized.v1.json",
  "title": "vulnerabilities.normalized v1",
  "description": "A raw source artifact was normalized: its valid records are committed to the vulnerability tables. Consumers must dedupe by eventId.",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "vulnerabilities.normalized"
    },
    "version": {
      "const": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "source": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "ecosystem": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "artifactSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "adapterVersion": {
      "type": "integer",
      "minimum": 1
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upserted": {
          "type": "integer",
          "minimum": 0
        },
        "unchanged": {
          "type": "integer",
          "minimum": 0
        },
        "quarantined": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "upserted",
        "unchanged",
        "quarantined"
      ]
    }
  },
  "required": [
    "eventId",
    "type",
    "version",
    "timestamp",
    "correlationId",
    "source",
    "ecosystem",
    "artifactSha256",
    "adapterVersion",
    "counts"
  ],
  "additionalProperties": false
}
